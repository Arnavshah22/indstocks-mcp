# ---------------------------------------------------------------------------
# Option 1 — paste a token. Simplest, but it dies after 24 hours.
# ---------------------------------------------------------------------------
# Generate at https://www.indstocks.com/app/api-trading/access-tokens
INDSTOCKS_TOKEN=

# ---------------------------------------------------------------------------
# Option 2 — let the server mint its own tokens.
# ---------------------------------------------------------------------------
# Set up TOTP on the same page. The dashboard then shows a client id (used as the
# API key) alongside the authenticator key.
#
# With these two set, the refresh_token tool needs only the current six-digit code
# from your authenticator app: no restart, no editing your MCP client's config.
INDSTOCKS_API_KEY=
INDSTOCKS_MPIN=

# Adding the authenticator seed makes refresh fully unattended — and puts your
# second factor in the same file as your MPIN. Anyone who can read that can mint
# tokens for this account indefinitely, and those tokens are NOT limited to this
# read-only server: they place orders against the real API just as well.
#
# Enable this deliberately or not at all.
INDSTOCKS_TOTP_SECRET=
